# Copy values into your local .env; replace the placeholder password first.
# This example matches a host MySQL listening on port 3307, not Compose's db host.
DATABASE_URL=mysql+pymysql://supplylens:replace_with_local_password@127.0.0.1:3307/supplylens?charset=utf8mb4
AUTO_SEED=true
AS_OF_DATE=2026-10-24
API_URL=http://127.0.0.1:8000
AGENT_MODE=demo
EMBEDDING_MODE=local
MODEL_API_KEY=
# For real model calls, retain your existing model settings from .env.glm.example.
