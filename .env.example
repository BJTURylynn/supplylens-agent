# Default: offline deterministic demo. Every record is synthetic.
AGENT_MODE=demo
EMBEDDING_MODE=local
DATABASE_URL=sqlite:///./runtime/supplylens.db
AS_OF_DATE=2026-10-24
API_URL=http://127.0.0.1:8000

# Cloud mode: set both AGENT_MODE=cloud and EMBEDDING_MODE=cloud.
# Obtain an API key yourself; no key is included in this repository.
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
REQUEST_TIMEOUT_SECONDS=60
MODEL_TIMEOUT_SECONDS=20
MAX_TOOL_CALLS=8
MAX_MODEL_ROUNDS=5
AUTO_SEED=true
# For an independent business-data database, use AUTO_SEED=false and e.g.
# DATABASE_URL=sqlite:///./runtime/business.db

# Only used by Docker Compose. Replace these local demo passwords if needed.
MYSQL_ROOT_PASSWORD=supplylens-local-root
MYSQL_PASSWORD=supplylens-local-demo

